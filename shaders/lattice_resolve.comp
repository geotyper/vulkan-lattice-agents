#version 450
#extension GL_GOOGLE_include_directive : require

#include "neuro/brain_kernel.glsl"
#include "lattice/lattice_kernel.glsl"
#include "simulation/step_parameters.glsl"
#include "simulation/agent_layout.glsl"

// The move half of a step: every bid is in, so who won is settled and each agent
// can be told the answer without looking at any other. This is also where the
// step's accumulators are charged, so that what fitness counts and what the
// lattice did are decided in one place.
//
// The occupancy writes below never collide. An agent only ever clears its own
// former cell, and a cell can only be won if it was empty when the step began --
// so the cell being written and the cell being cleared are always different
// cells with different owners.
//
// Mirrors the "resolve" loop of vkexp::stepLatticeCpu.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// The buffer the step pass just wrote, read and written in place: this pass adds
// to a record rather than producing a new one.
layout(std430, set = 0, binding = 0) buffer Agents {
    Agent agents[];
};
layout(std430, set = 0, binding = 1) buffer Occupancy {
    int occupancy[];
};
layout(std430, set = 0, binding = 2) readonly buffer Claims {
    int claims[];
};
layout(std430, set = 0, binding = 3) readonly buffer StepParameterBlocks {
    StepParameters stepParameters[];
};
layout(std430, set = 0, binding = 4) buffer Structures {
    int structures[];
};
// The tail of the build funnel. The decide pass records every reason an attempt
// ended before a bid; whether the bid then won is only knowable here.
layout(std430, set = 0, binding = 5) buffer BuildOutcomes { uint buildOutcomes[]; };

layout(push_constant) uniform StepSelector {
    uint stepIndex;
} selector;

void main() {
    const uint id = gl_GlobalInvocationID.x;
    const StepParameters params = stepParameters[selector.stepIndex];
    if (id >= params.agentCount) {
        return;
    }

    Agent agent = agents[id];
    const uint worldBase = uint(agent.beacon.w) * params.cellsPerWorld;

    bool refused = agent.intent.w != 0;
    bool moved = false;
    if (agent.intent.xyz != agent.cell.xyz) {
        const uint wanted = latticeCellIndex(agent.intent.x, agent.intent.y, agent.intent.z,
                                             params.latticeWidth, params.latticeHeight);
        if (claims[worldBase + wanted] == int(id)) {
            const uint vacated = latticeCellIndex(agent.cell.x, agent.cell.y, agent.cell.z,
                                                  params.latticeWidth, params.latticeHeight);
            occupancy[worldBase + vacated] = LatticeNoOccupant;
            occupancy[worldBase + wanted] = int(id);
            // cell.w is untouched: facing is state the agent owns and only a
            // turn changes it. A move that rewrote it would mean an agent could
            // never walk one way while looking another, and climbing a wall is
            // exactly that.
            agent.cell.xyz = agent.intent.xyz;
            moved = true;
        } else {
            // A build claim is a new wall, not a failed collision with an
            // agent, and construction walls carry no refusal penalty.
            refused = !latticeWorldBuilds(params.worldMode) ||
                      claims[worldBase + wanted] >= 0;
        }
    }
    // The flag the next step reads back as a self input, so a policy can notice
    // it is stuck without having to infer it from the neighbourhood.
    agent.intent = ivec4(agent.cell.xyz, refused ? 1 : 0);
    // And how long it has been standing still, which the refusal flag cannot
    // say: an agent that never asked to move was never refused. Counted here
    // because this is the pass that knows whether the move happened.
    agent.memory.z = moved ? 0.0 : agent.memory.z + 1.0;

    if (latticeWorldBuilds(params.worldMode) && agent.beacon.x >= 0) {
        const uint target = latticeCellIndex(agent.beacon.x, agent.beacon.y, agent.beacon.z,
                                             params.latticeWidth, params.latticeHeight);
        // Re-check emptiness at commit time. The decide pass already rejects an
        // occupied target, but this makes "build twice" impossible even if a
        // future action starts changing structures between the two passes.
        bool placed = false;
        if (claims[worldBase + target] == latticeBuildClaim(id, params.agentCount) &&
            structures[worldBase + target] == LatticeNoStructure) {
            structures[worldBase + target] = int(id) + 1;
            agent.signal.z = float(params.buildIntervalTicks);
            agent.signal.w = 1.0;
            agent.metrics.y += 1.0;
            placed = true;
        }
        atomicAdd(buildOutcomes[uint(agent.beacon.w) * LatticeBuildOutcomeCount +
                                (placed ? LatticeBuildPlaced : LatticeBuildContested)],
                  1u);
    }

    agent.metrics.z += (moved ? 1.0 : 0.0) + fitnessSignalCostFactor(params.fitness) * agent.signal.x;
    if (latticeWorldHarvests(params.worldMode)) {
        // Pick up at the resource, score on the floor. Fetching rather than
        // touching: a load that has to come back down makes a route pay off
        // every time it is used, so what is selected for is a path rather than
        // one lucky scramble. See PLAN.md.
        const uint hash = latticeResourceHash(uint(agent.beacon.w), params.beaconSeed);
        const int resourceX = latticeResourceX(hash, params.latticeWidth, params.groundWidth);
        const int resourceY = latticeResourceY(hash, params.resourceHeightLow,
                                               params.resourceHeightHigh, params.latticeHeight);
        const int resourceZ = latticeResourceZ(hash, params.latticeWidth, params.latticeDepth);
        const uint distance = latticeStepDistance(params.neighborhood, resourceX - agent.cell.x,
                                                  resourceY - agent.cell.y,
                                                  resourceZ - agent.cell.z);
        // The shaping, and the only gradient an early population has: nobody
        // reaches height four by accident, so how near anyone ever got is what
        // selection has to work with until somebody arrives.
        agent.metrics.x = max(agent.metrics.x, latticeNearness(distance, params.maximumDistance));
        if (agent.memory.w <= 0.0) {
            if (latticeBeaconReached(distance, params.beaconContactRadius)) {
                agent.memory.w = 1.0;
            }
        } else if (latticeGroundColumn(agent.cell.x, params.groundWidth) &&
                   agent.cell.y <= 1) {
            // Scored on the ground the group started from, not on any floor: a
            // load dropped at the far end would otherwise pay without the walk
            // back, and it is the walk back that makes a route worth building
            // well rather than once.
            agent.memory.w = 0.0;
            agent.metrics.w += 1.0;
        }
    } else if (params.worldMode == LatticeWorldConstruction) {
        const bool onHorizontalPerimeter =
            agent.cell.x == 0 || agent.cell.z == 0 ||
            agent.cell.x == int(params.latticeWidth) - 1 ||
            agent.cell.z == int(params.latticeDepth) - 1;
        agent.metrics.w += onHorizontalPerimeter ? 1.0 : 0.0;
        agent.metrics.x = max(agent.metrics.x,
                              float(agent.cell.y + 1) / float(max(params.latticeHeight, 1u)));
    } else {
        if (refused) {
            agent.metrics.w += 1.0;
        }
        const uint distance =
            latticeStepDistance(params.neighborhood, agent.beacon.x - agent.cell.x,
                                agent.beacon.y - agent.cell.y, agent.beacon.z - agent.cell.z);
        agent.metrics.x = max(agent.metrics.x, latticeNearness(distance, params.maximumDistance));
        if (latticeBeaconReached(distance, params.beaconContactRadius)) {
            agent.metrics.y += 1.0;
        }
    }

    agents[id] = agent;
}
