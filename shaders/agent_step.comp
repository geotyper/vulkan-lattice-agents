#version 450
#extension GL_GOOGLE_include_directive : require

#include "neuro/brain_kernel.glsl"
#include "simulation/step_parameters.glsl"
#include "simulation/trail_kernel.glsl"
#include "simulation/agent_layout.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;


layout(std430, set = 0, binding = 0) readonly buffer InputAgents {
    Agent inputAgents[];
};
layout(std430, set = 0, binding = 1) writeonly buffer OutputAgents {
    Agent outputAgents[];
};
layout(std430, set = 0, binding = 2) readonly buffer GenomeWeights {
    float weights[];
};
layout(std430, set = 0, binding = 3) readonly buffer GridHeads {
    int gridHeads[];
};
layout(std430, set = 0, binding = 4) readonly buffer GridLinks {
    int gridNext[];
};

// Step parameters live in a storage buffer indexed by step rather than in push
// constants: with the scenario block the structure exceeds the 128 bytes Vulkan
// guarantees for maxPushConstantsSize.
layout(std430, set = 0, binding = 5) readonly buffer StepParameterBlocks {
    StepParameters stepParameters[];
};
layout(std430, set = 0, binding = 6) readonly buffer TrailField {
    uint trailValues[];
};

layout(push_constant) uniform StepSelector {
    uint stepIndex;
} selector;

// Assigned once at the top of main; every helper below reads it.
StepParameters params;

#include "worlds/world_scenarios.glsl"

vec2 activeBeaconPosition(Agent agent, uint beaconIndex) {
    return scenarioBeaconPosition(params.beaconScenario, agent, beaconIndex, params.beaconPhase,
                                 params.worldRadius, params.scenario);
}

vec3 activeBeaconColor(uint beaconIndex, uint trial) {
    return scenarioBeaconColorCue(params.beaconScenario, beaconIndex, params.beaconPhase, trial,
                                  params.beaconCount, params.uniformBeaconColor);
}

float nearestBeaconDistance(Agent agent, vec2 position) {
    return scenarioTargetDistance(params.beaconScenario, agent, position, params.beaconPhase,
                                  params.worldRadius, params.beaconCount, params.scenario);
}

#include "worlds/scenario_steps.glsl"

float rangeFalloff(float distanceToLight) {
    return brainRangeFalloff(distanceToLight, params.lightSensorRange);
}

ivec2 gridCoordinate(vec2 position) {
    return clamp(ivec2(floor((position + vec2(params.worldRadius)) / params.gridCellSize)),
                 ivec2(0), ivec2(int(params.gridWidth) - 1));
}

void recordTouch(inout Agent agent, uint sector, float strength, bool wall) {
    strength = clamp(strength, 0.0, 1.0);
    if (wall) {
        if (sector < 4) {
            agent.wallTouch0[sector] = max(agent.wallTouch0[sector], strength);
        } else {
            agent.wallTouch1[sector - 4] = max(agent.wallTouch1[sector - 4], strength);
        }
    } else {
        if (sector < 4) {
            agent.agentTouch0[sector] = max(agent.agentTouch0[sector], strength);
        } else {
            agent.agentTouch1[sector - 4] = max(agent.agentTouch1[sector - 4], strength);
        }
    }
}

uint contactSector(vec2 direction, float agentAngle) {
    float relative = mod(atan(direction.y, direction.x) - agentAngle + ScenarioTau / 16.0, ScenarioTau);
    if (relative < 0.0) {
        relative += ScenarioTau;
    }
    return uint(relative / ScenarioTau * 8.0) % 8;
}

void main() {
    const uint id = gl_GlobalInvocationID.x;
    params = stepParameters[selector.stepIndex];
    if (id >= params.agentCount) {
        return;
    }

    Agent agent = inputAgents[id];
    const uint trial = id % params.trialsPerGenome;
    const uint world = uint(max(agent.penalties.w, 0.0) + 0.5);
    vec3 radiance[BrainLightReceptorCount];
    for (uint receptor = 0; receptor < BrainLightReceptorCount; ++receptor) {
        radiance[receptor] = vec3(0.0);
    }

    vec2 receptorDirections[BrainLightReceptorCount];
    for (uint receptor = 0; receptor < BrainLightReceptorCount; ++receptor) {
        const float fraction = float(receptor) / float(BrainLightReceptorCount - 1);
        const float sensorAngle =
            agent.pose.z + (fraction - 0.5) * params.sensorFieldOfView;
        receptorDirections[receptor] = vec2(cos(sensorAngle), sin(sensorAngle));
    }
    for (uint beaconIndex = 0; beaconIndex < params.beaconCount; ++beaconIndex) {
        const vec2 beaconPosition = activeBeaconPosition(agent, beaconIndex);
        // Mirrors the occlusion test in Sensors.cpp. Per beacon and not per
        // receptor: a beacon is a point, so either the line to it is clear or
        // the beacon is not there at all.
        if (scenarioSightBlocked(params.beaconScenario, agent, agent.pose.xy, beaconPosition,
                                 params.worldRadius, params.obstacleCount, params.scenario)) {
            continue;
        }
        const vec2 toBeacon = beaconPosition - agent.pose.xy;
        const float beaconDistanceSquared = dot(toBeacon, toBeacon);
        const float beaconDistance = sqrt(max(beaconDistanceSquared, 1.0e-8));
        const vec2 beaconDirection = toBeacon / beaconDistance;
        const float normalizedDistanceSquared =
            beaconDistanceSquared / (params.worldRadius * params.worldRadius);
        const float beaconAttenuation = brainDistanceAttenuation(normalizedDistanceSquared);
        const float beaconFalloff = rangeFalloff(beaconDistance);
        for (uint receptor = 0; receptor < BrainLightReceptorCount; ++receptor) {
            const float alignment = max(dot(receptorDirections[receptor], beaconDirection), 0.0);
            radiance[receptor] += activeBeaconColor(beaconIndex, trial) *
                                  brainReceptorResponse(alignment) * beaconAttenuation *
                                  beaconFalloff;
        }
    }
    scenarioBeforeStep(agent);

    vec2 positionCorrection = vec2(0.0);
    vec2 collisionVelocity = vec2(0.0);
    // Fraction of an overlap resolved this step. Written in the same
    // exp(-rate * dt) form as the drags so halving the step rate leaves the
    // contact behaviour unchanged instead of doubling how fast it resolves.
    const float contactResolve = 1.0 - exp(-params.contactStiffness * params.deltaTime);
    agent.wallTouch0 = vec4(0.0);
    agent.wallTouch1 = vec4(0.0);
    agent.agentTouch0 = vec4(0.0);
    agent.agentTouch1 = vec4(0.0);
    const ivec2 centerCell = gridCoordinate(agent.pose.xy);
    const int cellReach = int(ceil(params.lightSensorRange / params.gridCellSize));
    for (int offsetY = -cellReach; offsetY <= cellReach; ++offsetY) {
        for (int offsetX = -cellReach; offsetX <= cellReach; ++offsetX) {
            const ivec2 cell = centerCell + ivec2(offsetX, offsetY);
            if (any(lessThan(cell, ivec2(0))) ||
                any(greaterThanEqual(cell, ivec2(int(params.gridWidth))))) {
                continue;
            }
            const uint cellIndex = world * params.gridCellsPerWorld +
                                   uint(cell.y) * params.gridWidth + uint(cell.x);
            int otherId = gridHeads[cellIndex];
            uint guard = 0;
            while (otherId >= 0 && guard++ < params.agentCount) {
                if (uint(otherId) != id) {
                    const Agent other = inputAgents[otherId];
                    const vec2 toOther = other.pose.xy - agent.pose.xy;
                    const float distanceSquared = dot(toOther, toOther);
                    const float distanceToOther = sqrt(max(distanceSquared, 1.0e-8));
                    const vec2 directionToOther =
                        distanceSquared > 1.0e-8
                            ? toOther / distanceToOther
                            : vec2(id < uint(otherId) ? 1.0 : -1.0, 0.0);
                    if (params.agentLightEnabled != 0 &&
                        distanceToOther <= params.lightSensorRange && other.signal.a > 0.0 &&
                        // Agent light is GPU-only state, like the trail field, so
                        // this has no CPU counterpart to keep in step -- but a
                        // signal seen through a wall would be as wrong here as a
                        // beacon seen through one.
                        !scenarioSightBlocked(params.beaconScenario, agent, agent.pose.xy,
                                              other.pose.xy, params.worldRadius,
                                              params.obstacleCount, params.scenario)) {
                        const float relativeDistance = distanceToOther / params.lightSensorRange;
                        const float attenuation =
                            rangeFalloff(distanceToOther) /
                            (1.0 + relativeDistance * relativeDistance * 8.0);
                        for (uint receptor = 0; receptor < BrainLightReceptorCount;
                             ++receptor) {
                            const float alignment =
                                max(dot(receptorDirections[receptor], directionToOther), 0.0);
                            radiance[receptor] += other.signal.rgb * other.signal.a * 0.02 *
                                                  brainReceptorResponse(alignment) * attenuation;
                        }
                    }

                    const float contactDistance = agent.pose.w + other.pose.w;
                    if (params.agentCollisionsEnabled != 0 &&
                        distanceToOther < contactDistance) {
                        const vec2 normal = -directionToOther;
                        const float penetration = contactDistance - distanceToOther;
                        positionCorrection += normal * penetration * 0.5 * contactResolve;
                        const float relativeNormalSpeed =
                            dot(agent.motion.xy - other.motion.xy, normal);
                        if (relativeNormalSpeed < 0.0) {
                            collisionVelocity += normal *
                                (-(1.0 + params.collisionRestitution) *
                                 relativeNormalSpeed * 0.5);
                        }
                        const float strength = 0.25 + penetration / contactDistance +
                                               max(-relativeNormalSpeed, 0.0) /
                                                   params.maximumSpeed;
                        recordTouch(agent, contactSector(directionToOther, agent.pose.z), strength,
                                    false);
                    }
                }
                otherId = gridNext[otherId];
            }
        }
    }

    // Every index below comes from the shared preset, exactly as Sensors.cpp
    // does on the CPU side.
    float inputs[BrainInputCapacity];
    for (uint receptor = 0; receptor < BrainLightReceptorCount; ++receptor) {
        const vec3 observed = vec3(1.0) - exp(-params.lightExposure * radiance[receptor]);
        inputs[brainLightChannelIndex(receptor, 0u)] = observed.r;
        inputs[brainLightChannelIndex(receptor, 1u)] = observed.g;
        inputs[brainLightChannelIndex(receptor, 2u)] = observed.b;
        inputs[brainLightChannelIndex(receptor, 3u)] =
            brainLuminance(observed.r, observed.g, observed.b);
    }
    for (uint sector = 0; sector < BrainTactileSectorCount; ++sector) {
        const uint component = sector % 4;
        inputs[brainTactileChannelIndex(sector, 0u)] =
            sector < 4 ? inputAgents[id].wallTouch0[component]
                       : inputAgents[id].wallTouch1[component];
        inputs[brainTactileChannelIndex(sector, 1u)] =
            sector < 4 ? inputAgents[id].agentTouch0[component]
                       : inputAgents[id].agentTouch1[component];
    }
    // Ground feelers. Each tip reads the trail cell under it; the tips are far
    // enough apart to land in different cells, which is what makes the reading a
    // gradient rather than three copies of one number.
    for (uint antenna = 0u; antenna < BrainAntennaCount; ++antenna) {
        const float tipAngle = agent.pose.z + brainAntennaAngle(antenna);
        const vec2 tip = agent.pose.xy + vec2(cos(tipAngle), sin(tipAngle)) * BrainAntennaLength;
        const uint cell =
            trailCellIndex(tip, params.worldRadius, params.trailCellSize, params.trailWidth);
        for (uint channel = 0u; channel < BrainAntennaChannels; ++channel) {
            const float deposit =
                params.trailEnabled == 0u
                    ? 0.0
                    : float(trailValues[trailValueIndex(world, params.trailCellsPerWorld, cell,
                                                        channel)]) /
                          TrailFixedPointScale;
            inputs[brainAntennaChannelIndex(antenna, channel)] = brainTrailResponse(deposit);
        }
    }

    inputs[BrainSelfOffset] = clamp(length(agent.motion.xy) / params.maximumSpeed, 0.0, 1.0);
    inputs[BrainSelfOffset + 1u] =
        clamp(agent.motion.z / params.maximumAngularSpeed, -1.0, 1.0);
    inputs[BrainSelfOffset + 2u] = clamp(agent.motion.w, 0.0, 1.0);
    inputs[BrainSelfOffset + 3u] = clamp(agent.signal.w, 0.0, 1.0);
    inputs[BrainTaskOffset] = clamp(agent.internal.x, 0.0, 1.0);
    inputs[BrainTaskOffset + 1u] = clamp(agent.internal.y, 0.0, 1.0);
    inputs[BrainRecurrentInputOffset] = clamp(agent.internal.z, -1.0, 1.0);
    inputs[BrainRecurrentInputOffset + 1u] = clamp(agent.internal.w, -1.0, 1.0);

    // Same construction as vkexp::neuro::evaluate: the addressing lives in
    // BrainKernel.inl, only the substrate differs -- one genome per invocation,
    // offset into the shared genome buffer.
    const uint genome = id / params.trialsPerGenome;
    const uint inputCount = brainLayoutInputCount(params.brainLayout);
    const uint hiddenCount = brainLayoutHiddenCount(params.brainLayout);
    const uint outputCount = brainLayoutOutputCount(params.brainLayout);
    const uint base = genome * brainLayoutStride(params.brainLayout);
    float hidden[BrainHiddenCapacity];
    for (uint neuron = 0; neuron < hiddenCount; ++neuron) {
        float activation = weights[brainHiddenBiasIndex(base, inputCount, hiddenCount, neuron)];
        for (uint inputIndex = 0; inputIndex < inputCount; ++inputIndex) {
            activation += weights[brainHiddenWeightIndex(base, inputCount, neuron, inputIndex)] *
                          inputs[inputIndex];
        }
        // Where the time constant comes from is the only thing the model
        // changes, exactly as in vkexp::neuro::evaluate. Reactive pins it to the
        // step, which the shared integrator turns into a plain assignment; gated
        // recomputes it from the inputs through the same mapping the gene uses,
        // so a constant gate is the fixed-time-constant neuron.
        float timeConstant = params.deltaTime;
        if (params.neuronModel == NeuronModelTimeConstant) {
            timeConstant = brainTimeConstant(weights[brainTimeConstantGeneIndex(
                base, inputCount, hiddenCount, outputCount, neuron)]);
        } else if (params.neuronModel == NeuronModelGated) {
            float gate =
                weights[brainGateBiasIndex(base, inputCount, hiddenCount, outputCount, neuron)];
            for (uint gateInput = 0; gateInput < inputCount; ++gateInput) {
                gate += weights[brainGateWeightIndex(base, inputCount, hiddenCount, outputCount,
                                                     neuron, gateInput)] *
                        inputs[gateInput];
            }
            timeConstant = brainTimeConstant(gate);
        }
        const float state = brainIntegrateNeuron(agentHiddenState(agent, neuron), activation,
                                                 timeConstant, params.deltaTime);
        agent.hidden[neuron >> 2u][neuron & 3u] = state;
        hidden[neuron] = brainActivation(state);
    }
    float outputs[BrainOutputCapacity];
    for (uint neuron = 0; neuron < outputCount; ++neuron) {
        float activation =
            weights[brainOutputBiasIndex(base, inputCount, hiddenCount, outputCount, neuron)];
        for (uint hiddenIndex = 0; hiddenIndex < hiddenCount; ++hiddenIndex) {
            activation += weights[brainOutputWeightIndex(base, inputCount, hiddenCount, neuron,
                                                         hiddenIndex)] *
                          hidden[hiddenIndex];
        }
        outputs[neuron] = brainActivation(activation);
    }

    const float left = outputs[BrainMotorLeftOutput];
    const float right = outputs[BrainMotorRightOutput];
    const vec2 forward = vec2(cos(agent.pose.z), sin(agent.pose.z));
    const float drive = 0.5 * (left + right) * params.thrust;
    agent.motion.xy += forward * drive * params.deltaTime;
    agent.motion.xy *= exp(-params.linearDrag * params.deltaTime);
    agent.motion.z += (right - left) * params.turnAcceleration * params.deltaTime;
    agent.motion.z *= exp(-params.angularDrag * params.deltaTime);
    agent.motion.xy += collisionVelocity;
    const float speed = length(agent.motion.xy);
    if (speed > params.maximumSpeed) {
        agent.motion.xy *= params.maximumSpeed / speed;
    }
    agent.motion.z = clamp(agent.motion.z, -params.maximumAngularSpeed,
                           params.maximumAngularSpeed);
    const float correctionLength = length(positionCorrection);
    if (correctionLength > agent.pose.w) {
        positionCorrection *= agent.pose.w / correctionLength;
    }
    agent.pose.xy += agent.motion.xy * params.deltaTime + positionCorrection;
    agent.pose.z += agent.motion.z * params.deltaTime;

    // Mirrors the obstacle loop in stepAgentCpu, before the arena boundary so
    // the arena has the last word on containment. An obstacle reports through
    // the same tactile channel a wall does: to the network a barrier is a
    // barrier, and no new input has to be found room for.
    for (uint index = 0u; index < params.obstacleCount; ++index) {
        const vec2 push = boxPushOut(
            agent.pose.xy, agent.pose.w,
            scenarioObstacleCentre(params.beaconScenario, agent, index, params.worldRadius,
                                   params.scenario),
            scenarioObstacleHalfExtent(params.beaconScenario, index, params.worldRadius));
        const float pushLength = length(push);
        if (pushLength <= 0.0) {
            continue;
        }
        agent.pose.xy += push;
        const vec2 normal = push / pushLength;
        const float into = -dot(agent.motion.xy, normal);
        if (into > 0.0) {
            agent.motion.xy += normal * into * (1.0 + params.collisionRestitution);
        }
        recordTouch(agent, contactSector(normal, agent.pose.z),
                    0.25 + max(into, 0.0) / params.maximumSpeed, true);
    }

    const float maximumCenterDistance = max(params.worldRadius - agent.pose.w, 0.0);
    if (params.worldShape == 0) {
        const float centerDistance = length(agent.pose.xy);
        if (centerDistance > maximumCenterDistance) {
            const vec2 normal = agent.pose.xy / centerDistance;
            agent.pose.xy = normal * maximumCenterDistance;
            const float outward = dot(agent.motion.xy, normal);
            if (outward > 0.0) {
                agent.motion.xy -= normal * outward * 1.5;
            }
            recordTouch(agent, contactSector(normal, agent.pose.z),
                        0.25 + max(outward, 0.0) / params.maximumSpeed, true);
        }
    } else {
        if (agent.pose.x > maximumCenterDistance) {
            agent.pose.x = maximumCenterDistance;
            recordTouch(agent, contactSector(vec2(1.0, 0.0), agent.pose.z),
                        0.25 + max(agent.motion.x, 0.0) / params.maximumSpeed, true);
            agent.motion.x = min(agent.motion.x, 0.0) - max(agent.motion.x, 0.0) * 0.5;
        } else if (agent.pose.x < -maximumCenterDistance) {
            agent.pose.x = -maximumCenterDistance;
            recordTouch(agent, contactSector(vec2(-1.0, 0.0), agent.pose.z),
                        0.25 - min(agent.motion.x, 0.0) / params.maximumSpeed, true);
            agent.motion.x = max(agent.motion.x, 0.0) - min(agent.motion.x, 0.0) * 0.5;
        }
        if (agent.pose.y > maximumCenterDistance) {
            agent.pose.y = maximumCenterDistance;
            recordTouch(agent, contactSector(vec2(0.0, 1.0), agent.pose.z),
                        0.25 + max(agent.motion.y, 0.0) / params.maximumSpeed, true);
            agent.motion.y = min(agent.motion.y, 0.0) - max(agent.motion.y, 0.0) * 0.5;
        } else if (agent.pose.y < -maximumCenterDistance) {
            agent.pose.y = -maximumCenterDistance;
            recordTouch(agent, contactSector(vec2(0.0, -1.0), agent.pose.z),
                        0.25 - min(agent.motion.y, 0.0) / params.maximumSpeed, true);
            agent.motion.y = max(agent.motion.y, 0.0) - min(agent.motion.y, 0.0) * 0.5;
        }
    }
    const float wallContactAmount = dot(agent.wallTouch0 + agent.wallTouch1, vec4(1.0));
    agent.penalties.x += wallContactAmount * params.wallCollisionPenalty * params.deltaTime;

    const float motorCost = (abs(left) + abs(right)) * params.deltaTime;
    const float signalIntensity = max(outputs[BrainSignalIntensityOutput], 0.0);
    const float signalCost = signalIntensity * params.deltaTime * params.fitness.signalCostFactor;
    agent.motion.w =
        max(0.0, agent.motion.w - (motorCost + signalCost) * params.fitness.energyDrain);
    agent.signal = vec4(outputs[BrainSignalColorOutput] * 0.5 + 0.5,
                        outputs[BrainSignalColorOutput + 1u] * 0.5 + 0.5,
                        outputs[BrainSignalColorOutput + 2u] * 0.5 + 0.5, signalIntensity);
    if (outputCount >= BrainOutputCapacity) {
        agent.internal.z = outputs[BrainRecurrentOutputOffset];
        agent.internal.w = outputs[BrainRecurrentOutputOffset + 1u];
    } else {
        agent.internal.z = 0.0;
        agent.internal.w = 0.0;
    }
    const float distance = nearestBeaconDistance(agent, agent.pose.xy);
    agent.metrics.y = min(agent.metrics.y, distance);
    agent.metrics.z += motorCost + signalCost;
    scenarioAfterStep(agent, distance);
    outputAgents[id] = agent;
}
