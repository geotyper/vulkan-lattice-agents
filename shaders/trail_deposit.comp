#version 450
#extension GL_GOOGLE_include_directive : require

// One invocation per agent. Agents lay a faint track always and a coloured one
// when they signal; the first agent of each logical world also lays the beacon's
// own mark, so a beacon is deposited once per world rather than once per agent.
//
// Every write is an integer atomicAdd, which is commutative and exact: the order
// the GPU schedules agents in cannot change the resulting field.

#include "simulation/trail_kernel.glsl"
#include "simulation/step_parameters.glsl"
#include "neuro/brain_kernel.glsl"
#include "simulation/agent_layout.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;


layout(std430, set = 0, binding = 0) readonly buffer InputAgents {
    Agent inputAgents[];
};
layout(std430, set = 0, binding = 1) buffer TrailField {
    uint trailValues[];
};
layout(std430, set = 0, binding = 2) readonly buffer StepParameterBlocks {
    StepParameters stepParameters[];
};

layout(push_constant) uniform StepSelector {
    uint stepIndex;
} selector;

StepParameters params;

#include "worlds/world_scenarios.glsl"

void depositAt(vec2 position, uint world, vec3 color, float amount) {
    if (!trailContains(position, params.worldRadius)) {
        return;
    }
    const uint cell = trailCellIndex(position, params.worldRadius, params.trailCellSize,
                                     params.trailWidth);
    const vec3 scaled = max(color, vec3(0.0)) * amount;
    for (uint channel = 0u; channel < TrailChannels; ++channel) {
        const uint added = uint(scaled[channel]);
        if (added > 0u) {
            atomicAdd(trailValues[trailValueIndex(world, params.trailCellsPerWorld, cell, channel)],
                      added);
        }
    }
}

// Index of the first agent belonging to a logical world, derived the same way
// logicalWorldForAgent maps the other direction.
uint firstAgentOfWorld(uint world) {
    const uint trials = max(params.trialsPerGenome, 1u);
    const uint group = world / trials;
    return (group * params.agentsPerWorld) * trials + (world % trials);
}

void main() {
    const uint id = gl_GlobalInvocationID.x;
    params = stepParameters[selector.stepIndex];
    if (id >= params.agentCount || !trailFieldActive(params.trailMode)) {
        return;
    }

    const Agent agent = inputAgents[id];
    const uint world = uint(max(agent.penalties.w, 0.0) + 0.5);

    // A silent agent still leaves a track; signalling colours and brightens it.
    const vec3 track = agent.signal.rgb * (TrailAgentBaseIntensity + agent.signal.a);
    depositAt(agent.pose.xy, world, track, params.trailDeposit);

    if (id == firstAgentOfWorld(world)) {
        const uint trial = id % max(params.trialsPerGenome, 1u);
        for (uint beaconIndex = 0u; beaconIndex < params.beaconCount; ++beaconIndex) {
            const vec2 position =
                scenarioBeaconPosition(params.beaconScenario, agent, beaconIndex,
                                       params.beaconPhase, params.worldRadius, params.scenario);
            const vec3 color =
                scenarioBeaconColorCue(params.beaconScenario, beaconIndex, params.beaconPhase,
                                       trial, params.beaconCount, params.uniformBeaconColor);
            depositAt(position, world, color, params.beaconTrailDeposit);
        }
    }
}
